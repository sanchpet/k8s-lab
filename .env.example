# Copy to .env and adjust. .env is gitignored: it is the only place where values
# that identify a real fleet (DNS domain, mirror address, upstream hosts) may live.
# Everything committed here stays generic on purpose.

# --- cluster ---------------------------------------------------------------
CLUSTER_NAME=onprem
# Cluster DNS domain. Set it to whatever the fleet you are reproducing uses;
# keeping it non-default is itself part of the fidelity.
CLUSTER_DOMAIN=cluster.local
# Node image tag. Pin it: the containerd major version rides along, and the
# legacy registry.mirrors block is gone in containerd 2.x.
K8S_VERSION=v1.31.4

# --- registry mirror -------------------------------------------------------
# Namespace the mirror lives in, and the Service name clients resolve.
MIRROR_NAMESPACE=registry
MIRROR_SERVICE=registry-mirror
# Pinned ClusterIP for the mirror Service. containerd runs on the node and
# resolves through the host resolver, not cluster DNS, so the node reaches the
# mirror by address; the name is added to the nodes' /etc/hosts on top of it.
MIRROR_CLUSTER_IP=10.96.0.50
MIRROR_PORT=5000

# --- harbor ----------------------------------------------------------------
HARBOR_NAMESPACE=registry
HARBOR_ADMIN_PASSWORD=Harbor12345
HARBOR_CHART_VERSION=1.19.1
