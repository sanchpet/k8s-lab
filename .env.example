# Copy to .env and adjust. .env is gitignored: it is the only place where values
# that identify a real fleet (DNS domain, mirror address, upstream hosts) may live.
# Everything committed here stays generic on purpose.

# --- cluster ---------------------------------------------------------------
CLUSTER_NAME=onprem
# Cluster DNS domain. Set it to whatever the fleet you are reproducing uses;
# keeping it non-default is itself part of the fidelity.
CLUSTER_DOMAIN=cluster.local
# Node image tag. Pin it: the containerd major version rides along, and the
# legacy registry.mirrors block is gone in containerd 2.x.
K8S_VERSION=v1.31.4

# --- registry mirror -------------------------------------------------------
# Namespace the mirror lives in, and the Service name clients resolve.
MIRROR_NAMESPACE=registry
MIRROR_SERVICE=registry-mirror
# Pinned ClusterIP for the mirror Service. containerd runs on the node and
# resolves through the host resolver, not cluster DNS, so the node reaches the
# mirror by address; the name is added to the nodes' /etc/hosts on top of it.
MIRROR_CLUSTER_IP=10.96.0.50
MIRROR_PORT=5000

# --- harbor ----------------------------------------------------------------
HARBOR_NAMESPACE=registry
HARBOR_ADMIN_PASSWORD=Harbor12345
HARBOR_CHART_VERSION=1.19.1

# --- sa-token-capped env ---------------------------------------------------
# The API server's cap on ServiceAccount token lifetimes. One hour is the tightest
# value that starts: below it the API server refuses to boot.
SA_TOKEN_MAX_EXPIRATION=1h

# --- eso-serviceaccount-token scenario -------------------------------------
# The build under test. Both point into a working tree, so they are machine-local:
# ESO_IMAGE_ARCHIVE is what `docker save` wrote, ESO_CHART_DIR the chart beside it.
ESO_CHART_DIR=/path/to/external-secrets/deploy/charts/external-secrets
ESO_IMAGE_ARCHIVE=/path/to/external-secrets.tar
ESO_IMAGE_REPOSITORY=eso-lab
ESO_IMAGE_TAG=sa-token
ESO_NAMESPACE=external-secrets
# The workload the scenario applies. The requested lifetime must exceed the env's
# cap, otherwise there is no shortening to observe.
ESO_DEMO_NAMESPACE=demo
ESO_DEMO_SA=argocd-remote
ESO_DEMO_SECRET=argocd-remote-token
ESO_DEMO_AUDIENCE=https://kubernetes.default.svc.cluster.local
ESO_DEMO_REQUESTED_SECONDS=7200

# --- descheduler scenarios -------------------------------------------------
# Source and release under test. The binary is built from this ref into .cache/.
DESCHEDULER_REPO=https://github.com/kubernetes-sigs/descheduler.git
DESCHEDULER_VERSION=v0.37.0
# An older release to compare against (descheduler-oneshot-error-loop only).
DESCHEDULER_COMPARE_VERSION=v0.34.0
# A build carrying a candidate fix: a repository (URL or local path) and a ref in it.
# Leave empty to skip the checks that need it.
DESCHEDULER_FIX_REPO=
DESCHEDULER_FIX_REF=
# descheduler-stale-node-snapshot: pods put on the node that gets tainted, and their image.
DESCHEDULER_STALE_REPLICAS=60
DESCHEDULER_PAUSE_IMAGE=registry.k8s.io/pause:3.10
# descheduler-oneshot-error-loop: how long a failing process is given to exit on its own.
DESCHEDULER_LOOP_LIMIT_SECONDS=10
