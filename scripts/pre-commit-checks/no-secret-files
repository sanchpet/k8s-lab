#!/usr/bin/env bash
# Pre-commit guard: refuse to commit files that are meant to stay local.
#
# .gitignore is an intention, not an enforcement — `git add -f` walks straight past
# it, and so does a file whose name nobody thought to ignore yet. Two rules cover
# both: anything the repo already declares ignored must never arrive staged, and a
# deny list catches the names that carry credentials or cluster access by convention.
set -euo pipefail

DENY_GLOBS='.env .env.* */.env */.env.* *.pem *.key *.p12 *.pfx *id_rsa* *id_ed25519* kubeconfig* */kubeconfig* *.kubeconfig'
ALLOW_EXACT='.env.example'

staged=$(git diff --cached --name-only --diff-filter=AM)
[ -n "$staged" ] || exit 0

status=0
refuse() {
  printf 'refusing to commit %s: %s\n' "$1" "$2" >&2
  status=1
}

while IFS= read -r file; do
  [ -n "$file" ] || continue

  allowed=0
  for a in $ALLOW_EXACT; do
    if [ "$file" = "$a" ]; then allowed=1; fi
  done
  [ "$allowed" -eq 0 ] || continue

  # Staged despite being ignored means someone forced it past the declared intent.
  if git check-ignore -q -- "$file"; then
    refuse "$file" "matched by .gitignore — it was force-added"
    continue
  fi

  for glob in $DENY_GLOBS; do
    # shellcheck disable=SC2254  # the glob must stay unquoted to match as a pattern
    case $file in
      $glob) refuse "$file" "matches deny pattern '$glob'"; break ;;
    esac
  done
done <<EOF
$staged
EOF

[ $status -eq 0 ] || printf '\nKeep it out of the index; if it is genuinely safe, add it to ALLOW_EXACT in %s.\n' "$0" >&2
exit $status
